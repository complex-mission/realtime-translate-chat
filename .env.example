# App
APP_NAME="RealTime Translate Chat"
APP_URL=http://localhost:19716
ALLOWED_ORIGINS=http://localhost:19716,http://127.0.0.1:19716
NODE_ENV=development

# CM会议平台配置
NEXT_PUBLIC_APP_NAME=CM会议平台
NEXT_PUBLIC_APP_DESCRIPTION=实时翻译智能协作会议系统
NEXT_PUBLIC_APP_SLOGAN=实时翻译 · 智能协作 · 无界沟通
NEXT_PUBLIC_APP_FOOTER=让沟通无界

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=rt_translate

# Redis
REDIS_URL=redis://:password@127.0.0.1:6379/0

# JWT (change these!)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# DashScope (Qwen)
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_TEXT_MODEL=qwen3.5-plus
QWEN_LIVE_TRANSLATE_MODEL=qwen3-livetranslate-flash-2025-12-01

# Aliyun OSS
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_INTERNAL_ENDPOINT=http://oss-cn-beijing-internal.aliyuncs.com
OSS_USE_INTERNAL=false

# DingRTC (声网)
RTC_APP_ID=your_rtc_app_id
RTC_APP_KEY=your_rtc_app_key
NEXT_PUBLIC_RTC_APP_ID=your_rtc_app_id

# Admin seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_NICKNAME=管理员

# ===== Misc =====
MAX_IMAGE_SIZE_MB=10
MAX_MESSAGE_LENGTH=5000